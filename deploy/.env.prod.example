# ================= 语图生产环境配置 =================
# 同时供两个消费方读取：
#   1) docker compose --env-file .env.prod 做变量替换（DB_USER/DB_PASSWD/DB_DATABASE、镜像 tag）
#   2) 挂载为容器内 /app/.env.prod，NestJS 启动时解析（生产优先于 .env）
# 注意：KEY=value 等号两侧不能有空格
# 使用：cp .env.prod.example .env.prod 后填写 <...> 占位并 chmod 600
# ====================================================

# ---- 镜像 tag（deploy.sh/rollback.sh 自动维护）----
YUTU_BACKEND_TAG=latest
YUTU_FRONTEND_TAG=latest

# ---- 运行标识 ----
NODE_ENV=production
PORT=3001

# ---- PostgreSQL（host 必须是 Compose 服务名 postgres）----
DB_HOST=postgres
DB_PORT=5432
DB_USER=yutu
DB_PASSWD=<openssl rand -base64 18 生成的数据库密码>
DB_DATABASE=flowchart_editor
# 首次建库专用：建表完成后【必须整行删除】并重启 backend（见手册 5.4 节）
DB_SYNCHRONIZE=true

# ---- 鉴权（安全）----
# 生成命令：openssl rand -hex 32
# 代码强制校验：缺失或等于 secret123456 时后端拒绝启动
JWT_SECRET=<openssl rand -hex 32 生成的 64 位十六进制串>
# 令牌态存储：pg（auth_tokens 表，支持服务端吊销/登出）
TOKEN_STORE=pg
# CORS 白名单：逗号分隔。同源部署（前端经 Nginx 同域访问 /api）不触发跨域，此为兜底
CORS_ORIGINS=http://8.140.203.51

# ---- LLM（阿里云 DashScope，OpenAI 兼容协议）----
# 缺失时后端正常启动，AI 对话降级为规则/模板路径（流程图编辑不受影响）
DASHSCOPE_API_KEY=<阿里云百炼 DashScope API Key，无则留空>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型分层：大模型生成 / 中模型反思 / 小模型意图兜底
LLM_MODEL_LARGE=qwen-plus
LLM_MODEL_MEDIUM=qwen-turbo
LLM_MODEL_SMALL=qwen-turbo
# 单次调用输出硬上限（token 三级防护的调用级上限）
LLM_MAX_OUTPUT_TOKENS=4096

# ---- AI 记忆与嵌入 ----
# openai=复用 DASHSCOPE_API_KEY 走 DashScope embedding；留空字符串或 null 则向量路关闭、降级为摘要+关键词
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v3
# 短期记忆 Checkpointer：memory（默认，单机够用）| pg
CHECKPOINT_STORE=memory
# 长期记忆：pg（conversation_summaries / ai_long_term_memories 表）
LONG_TERM_STORE=pg

# ---- Token 配额（三级防护：用户级日配额 / 会话级软上限）----
AI_DAILY_GENERATE_LIMIT=200
AI_DAILY_MODIFY_LIMIT=500
AI_DAILY_TOKEN_LIMIT=500000
AI_SESSION_TOKEN_SOFT_LIMIT=100000
